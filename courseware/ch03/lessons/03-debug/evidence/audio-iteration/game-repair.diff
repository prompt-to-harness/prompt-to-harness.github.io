+
+/* 高分屏清晰渲染（必须在拿到 canvas 之后再设置尺寸） */
+const DPR = Math.min(2, window.devicePixelRatio || 1);
+canvas.width = W * DPR;
+canvas.height = H * DPR;
+
+/*
+ * 从主题令牌读取实际颜色（canvas 不认 var()）。
+ * 用惰性 getter 读取，避免样式表尚未解析完时拿到空值。
+ */
+const FALLBACK = {
+  accent3: '#56d6c6',
+  accent2: '#9a6bff',
+  warn: '#fbbf24',
+  bad: '#fb7185',
+};
+const tokenCache = new Map();
+
+function readToken(name, fallback) {
+  if (tokenCache.has(name)) return tokenCache.get(name);
+  let value = '';
+  try {
+    value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
+  } catch {
+    value = '';
+  }
+  const result = value || fallback;
+  tokenCache.set(name, result);
+  return result;
+}
+
+const C = {
+  get accent3() { return readToken('--pg-accent-3', FALLBACK.accent3); },
+  get accent2() { return readToken('--pg-accent-2', FALLBACK.accent2); },
+  get warn()    { return readToken('--pg-warn', FALLBACK.warn); },
+  get bad()     { return readToken('--pg-bad', FALLBACK.bad); },
+};
 
